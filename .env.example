PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/callconnect
JWT_SECRET=change-this-to-a-long-random-string
PLATFORM_FEE_PERCENT=10
# Fast billing for live testing (20s = 1 billable period, first 20s free)
DEMO_BILLING_FAST=true
BILLING_INTERVAL_MS=20000
FREE_PERIOD_MS=20000

# Ngrok (recommended for sharing localhost) — https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
